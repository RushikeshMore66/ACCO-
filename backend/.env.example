# ACCO Backend — Environment Variables
# Copy this file to .env and adjust values for your local setup.
# Never commit a real .env file.

ACCO_APP_NAME=ACCO
ACCO_ENVIRONMENT=development
ACCO_API_V1_PREFIX=/api/v1
ACCO_DATABASE_URL="postgresql+psycopg://acco_user:change_me@localhost:5432/acco_db"

# Authentication
# Generate a secret key using: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCO_JWT_SECRET_KEY="replace_this_with_a_long_random_string"
ACCO_ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCO_JWT_ISSUER="acco"

# AI reply analysis. Leave the key empty to keep provider calls disabled.
ACCO_OPENAI_API_KEY=
ACCO_OPENAI_MODEL=gpt-4o-mini
# Optional: only set this for an intentionally configured OpenAI-compatible endpoint.
ACCO_OPENAI_BASE_URL=
ACCO_OPENAI_TIMEOUT_SECONDS=20
ACCO_OPENAI_MAX_RETRIES=0
ACCO_REPLY_ANALYSIS_MAX_INPUT_CHARS=12000
ACCO_REPLY_ANALYSIS_PROMPT_VERSION=reply-v1
