# Environment Configuration for ACCO (Local Development)

# Application
ENVIRONMENT=development
PROJECT_NAME="ACCO — AI Accounts Receivable Agent"
API_V1_STR=/api/v1
SECRET_KEY=change-me-in-production-super-secret-key-min-32-chars
BUSINESS_TIMEZONE=UTC

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=acco_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Background Workers (Redis & Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider Configuration (Advisory only)
AI_PROVIDER=openai
AI_API_KEY=placeholder-do-not-commit-real-keys
AI_MODEL_NAME=gpt-4o-mini

# External Integrations (Optional Placeholders)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=acco-invoices-dev
